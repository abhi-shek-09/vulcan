# Copy this file to deployments/docker/.env before running
# `docker compose up`. Values here are consumed two ways:
#   1. POSTGRES_* are substituted directly into docker-compose.yml
#      (Postgres's own startup env, and the control-plane/migrate DB_URL).
#   2. Everything else overrides the container-internal defaults declared
#      in docker-compose.yml (${VAR:-default} syntax) -- safe to leave
#      unset, in which case services talk to each other via Compose
#      service DNS names as documented in docs/phase10.md#networking.

# --- PostgreSQL ---
POSTGRES_DB=vulcandb
POSTGRES_USER=vulcandev
POSTGRES_PASSWORD=changeme

# --- Control plane / worker / autoscaler (optional overrides) ---
# Leave these unset to use the Compose service-DNS defaults baked into
# docker-compose.yml (nats://nats:4222, http://victoriametrics:8428,
# http://control-plane:8080, etc). Only set them if you need to point a
# container at something other than the bundled Compose services.
#PORT=8080
#NATS_URL=nats://nats:4222
#VICTORIA_METRICS_URL=http://victoriametrics:8428
#CONTROL_PLANE_URL=http://control-plane:8080
#WORKER_CAPACITY_RPS=100
#WORKER_BINARY_PATH=/usr/local/bin/worker
#VULCAN_PROJECT_ROOT=/app
#AUTOSCALER_INTERVAL=5s
